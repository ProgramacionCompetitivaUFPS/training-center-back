# PostgreSQL (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=training_center
POSTGRES_PORT=5432

# App - Database connection (used by Go app)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=training_center

# App - Server
PORT=8080
JWT_SECRET=

# App - Email (MailHog for local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@trainingcenter.com

# App - Redis Rate Limiter
REDIS_URL=redis://localhost:6379

# Mock auth for development (Problem specs without User module)
# Use header X-Mock-User: admin | coach_john | coach_mary | contestant
MOCK_AUTH=1

# Storage configuration
# STORAGE_BACKEND=local (default) or gcs
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=.local_storage