# PostgreSQL (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=training_center
POSTGRES_PORT=5432

# App - Database connection (used by Go app)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=training_center

# App - Server
PORT=8080
JWT_SECRET=

# App - Email
# Local dev: MailHog (docker-compose includes it at localhost:1025, no auth needed)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@trainingcenter.com
# Gmail (staging/production):
#   1. Enable 2FA on the Google account.
#   2. Generate an App Password: Google Account → Security → App Passwords (16 chars, no spaces).
#   3. Set the variables below (replace the defaults above):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=trainingcenter.ufps@gmail.com
# SMTP_PASSWORD=<16-char-app-password>
# SMTP_FROM=Training Center <trainingcenter.ufps@gmail.com>

# App - Redis Rate Limiter
REDIS_URL=redis://localhost:6379

# App - RabbitMQ (submission queue)
# Leave empty to use no-op queue (submissions won't be judged)
# RABBITMQ_URL=amqp://judge:judge@localhost:5672/

# CORS — allowed origins, comma-separated
ALLOWED_ORIGINS=http://localhost:5173

# Frontend URL used to build links inside emails (invitations, password reset, etc.)
FRONTEND_BASE_URL=http://localhost:5173

# Nginx + Certbot
DOMAIN=training-center-staging.duckdns.org
CERTBOT_EMAIL=tucorreo@ejemplo.com

# Storage configuration
# STORAGE_BACKEND=local (default) or gcs
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=.local_storage

# Worker (cmd/worker) — judge system
# POD_MEMORY_LIMIT=2147483648          # total pod memory in bytes (K8s Downward API)
# POD_CPU_LIMIT=4000                   # pod CPU limit in MILLICORES (K8s Downward API, divisor 1m)
# JUDGE_CONFIG=config/judge_config.yaml  # language images, commands, idle timeout, overhead

# Admin seed (used by: go run cmd/seed/main.go)
# Only ADMIN_EMAIL and ADMIN_PASSWORD are required. The rest default to "admin".
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin1234!
# ADMIN_NAME=admin
# ADMIN_NICKNAME=admin
# ADMIN_COUNTRY=admin
# ADMIN_CITY=admin
# ADMIN_INSTITUTION=admin