# PostgreSQL (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=training_center
POSTGRES_PORT=5432

# App - Database connection (used by Go app)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=training_center

# App - Server
PORT=8080
JWT_SECRET=

# App - Email (MailHog for local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@trainingcenter.com

# App - Redis Rate Limiter
REDIS_URL=redis://localhost:6379

# App - RabbitMQ (submission queue)
# Leave empty to use no-op queue (submissions won't be judged)
# RABBITMQ_URL=amqp://judge:judge@localhost:5672/

# Mock auth for development (Problem specs without User module)
# Use header X-Mock-User: admin | coach_john | coach_mary | contestant
MOCK_AUTH=1

# CORS — allowed origins, comma-separated
ALLOWED_ORIGINS=http://localhost:5173

# Nginx + Certbot
DOMAIN=training-center-staging.duckdns.org
CERTBOT_EMAIL=tucorreo@ejemplo.com

# Storage configuration
# STORAGE_BACKEND=local (default) or gcs
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=.local_storage

# Admin seed (used by: go run cmd/seed/main.go)
# Only ADMIN_EMAIL and ADMIN_PASSWORD are required. The rest default to "admin".
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin1234!
# ADMIN_NAME=admin
# ADMIN_NICKNAME=admin
# ADMIN_COUNTRY=admin
# ADMIN_CITY=admin
# ADMIN_INSTITUTION=admin